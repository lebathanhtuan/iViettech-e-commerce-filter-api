PORT=3000

DB_NAME=e-commerce-filter_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Chuỗi bí mật để tạo token (access và refresh dùng 2 chuỗi khác nhau)
JWT_ACCESS_SECRET=e-commerce-filter-access-secret
JWT_REFRESH_SECRET=e-commerce-filter-refresh-secret

# Thời gian sống của token
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Địa chỉ public của server, dùng để tạo link ảnh đầy đủ (BASE_URL + /uploads/...)
BASE_URL=http://localhost:3000

# Địa chỉ frontend, dùng tạo link xem đơn hàng và đặt lại mật khẩu trong email.
# Phải khớp port/domain frontend thực tế; khi deploy dùng HTTPS.
CLIENT_URL=http://localhost:5173

# Địa danh mới (v2 sau sáp nhập 07/2025). Mặc định đã được cấu hình trong code.
# VIETNAM_PROVINCES_API_URL=https://provinces.open-api.vn/api/v2

# Gửi email đơn hàng và reset mật khẩu bằng Nodemailer (xem docs/password-reset.md)
# Để trống MAIL_USER / MAIL_PASSWORD: bỏ qua mail đơn hàng, quên mật khẩu trả 503.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MyShop <your-email@gmail.com>"

# ===== Khi deploy (Supabase + Vercel, xem DEPLOY.md trong repo frontend) =====
# Có DATABASE_URL thì bỏ qua DB_NAME / DB_USER / DB_PASSWORD / DB_HOST / DB_PORT
# Dùng Transaction pooler (port 6543) của Supabase
DATABASE_URL=
# Upload ảnh lên Supabase Storage (bắt buộc cả ở local nếu muốn test upload)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Dùng cho npm run db:sync / db:seed (đồng bộ database lên Supabase từ máy local)
# Để riêng biến này thì npm run dev ở local vẫn dùng DB local (DB_NAME, DB_USER...)
SUPABASE_DB_URL=
