PORT=3000

DB_NAME=e-commerce-filter_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Chuỗi bí mật để tạo token (access và refresh dùng 2 chuỗi khác nhau)
JWT_ACCESS_SECRET=e-commerce-filter-access-secret
JWT_REFRESH_SECRET=e-commerce-filter-refresh-secret

# Thời gian sống của token
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Địa chỉ public của server, dùng để tạo link ảnh đầy đủ (BASE_URL + /uploads/...)
BASE_URL=http://localhost:3000

# Địa chỉ trang frontend, dùng để tạo link "Xem đơn hàng" trong email
CLIENT_URL=http://localhost:5173

# Gửi email đơn hàng bằng Nodemailer (xem docs/order-email-nodemailer.md)
# Để trống MAIL_USER / MAIL_PASSWORD thì server bỏ qua bước gửi mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MyShop <your-email@gmail.com>"
